{
  "name": "crtvd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build:web": "npm run typecheck && vite build",
    "build": "npm run build:wasm && npm run build:web",
    "preview": "vite preview --host 127.0.0.1",
    "test:native": "node scripts/test-native.mjs",
    "test:wasm": "node tests/wasm.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "test": "npm run test:native && npm run test:wasm && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}

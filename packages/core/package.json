    },
    "./wasm/crtvd.js": "./lib/wasm/crtvd.js",
    "./wasm/crtvd.wasm": "./lib/wasm/crtvd.wasm",
    "./wasm/build.json": "./lib/wasm/build.json"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vael2196/CRTVD.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22.12.0"
  }

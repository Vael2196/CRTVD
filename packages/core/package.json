{
  "name": "@vael2196/crtvd",
  "version": "0.3.0",
  "description": "Reusable C++/WebAssembly palette reduction, resampling and dithering engine",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
